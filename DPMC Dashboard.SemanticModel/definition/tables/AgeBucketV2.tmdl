table AgeBucketV2
	lineageTag: 61934efb-c795-400a-a81d-1719865a46a3

	measure 'Vehicle Count (Unregistered) V2' =
			
			VAR SelectedDate = [Selected As Of Date]
			VAR SnapDate     = [Stock Snapshot Date]
			VAR MinD         = MIN ( AgeBucketV2[MinDays] )
			VAR MaxD         = MAX ( AgeBucketV2[MaxDays] )
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( gold_dpmc_vs_2w3w_factstock_v2[STR_CHASSIS_NO] ),
			    gold_dpmc_vs_2w3w_factstock_v2[DMT_LOADED_DATE] = SnapDate,
			    ISBLANK ( gold_dpmc_vs_2w3w_factstock_v2[STR_VEHICLE_NO] ),
			    NOT ISBLANK ( gold_dpmc_vs_2w3w_factstock_v2[DTM_DECLARE] ),
			    gold_dpmc_vs_2w3w_factstock_v2[DTM_DECLARE] < SelectedDate - MinD + 1,
			    gold_dpmc_vs_2w3w_factstock_v2[DTM_DECLARE] >= SelectedDate - MaxD
			)
		formatString: 0
		lineageTag: ab0d79c2-f4a7-4f4c-beff-cdd128e8462d

	column 'Age Bucket'
		dataType: string
		lineageTag: d7dd76fd-214c-430d-aa44-b2146bd81c48
		summarizeBy: none
		isNameInferred
		sourceColumn: [Age Bucket]
		sortByColumn: Sort

		annotation SummarizationSetBy = Automatic

	column MinDays
		formatString: 0
		lineageTag: e1165745-9847-4700-8728-37fed93400a9
		summarizeBy: sum
		isNameInferred
		sourceColumn: [MinDays]

		annotation SummarizationSetBy = Automatic

	column MaxDays
		formatString: 0
		lineageTag: eadc26b3-4446-4154-8acf-856654ff8803
		summarizeBy: sum
		isNameInferred
		sourceColumn: [MaxDays]

		annotation SummarizationSetBy = Automatic

	column Sort
		formatString: 0
		lineageTag: c0fd5728-e0d4-4eee-8cae-cbc482283482
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Sort]

		annotation SummarizationSetBy = Automatic

	partition AgeBucketV2 = calculated
		mode: import
		source =
				
				DATATABLE (
				    "Age Bucket", STRING,
				    "MinDays", INTEGER,
				    "MaxDays", INTEGER,
				    "Sort", INTEGER,
				    {
				        { "0-30",       0,   30,   1 },
				        { "31-60",      31,  60,   2 },
				        { "61-90",      61,  90,   3 },
				        { "91-120",     91,  120,  4 },
				        { "121-150",    121, 150,  5 },
				        { "151 above",  151, 9999, 6 }
				    }
				)

	annotation PBI_Id = 07d18eb845574f4f9207362233aa839f

