	measure 'Is In Stock Snapshot' =
			
			IF ( MAX ( gold_dpmc_vs_2w3w_factstock_v2[DMT_LOADED_DATE] ) = [Stock Snapshot Date], 1, 0 )
		formatString: 0
		lineageTag: 020a6bc7-d958-4121-8a32-57bba76a095d

	measure 'Stock Details Row Flag' =
			
			IF (
			    [Is In Stock Snapshot] = 0,
			    0,
			    IF (
			        ISFILTERED ( AgeBucketV2[Age Bucket] ),
			        [Is In Selected Age Bucket],
			        1
			    )
			)
		lineageTag: 14c63d86-8448-439a-a6e4-57d02588fcef

	measure 'Is In Selected Age Bucket' =
			
			VAR SelectedDate = [Selected As Of Date]
			VAR Declared     = MAX ( gold_dpmc_vs_2w3w_factstock_v2[DTM_DECLARE] )
			VAR AgeDays      = INT ( SelectedDate ) - INT ( Declared )
			RETURN
			IF (
			    [Is In Stock Snapshot] = 1
			        && ISBLANK ( MAX ( gold_dpmc_vs_2w3w_factstock_v2[STR_VEHICLE_NO] ) )
			        && NOT ISBLANK ( Declared )
			        && AgeDays >= MIN ( AgeBucketV2[MinDays] )
			        && AgeDays <= MAX ( AgeBucketV2[MaxDays] ),
			    1, 0
			)
		formatString: 0
		lineageTag: 53563763-5b50-4f40-9d13-6e71609f62ad

	measure 'Is Sale In MTD' =
			
			VAR SelectedDate = [Selected As Of Date]
			VAR MonthStart   = DATE ( YEAR ( SelectedDate ), MONTH ( SelectedDate ), 1 )
			VAR D            = MAX ( gold_dpmc_vs_2w3w4w_factsales[InvoiceDate] )
			RETURN
			IF ( NOT ISBLANK ( MAX ( gold_dpmc_vs_2w3w4w_factsales[InvoiceNo] ) ) && D >= MonthStart && D <= SelectedDate, 1, 0 )
		formatString: 0
		lineageTag: 82e77671-2b32-4956-9ce3-911e89571f0f

	measure 'Pending GRN Gate Passes' =
			
			VAR SelectedDate = [Selected As Of Date]
			VAR SnapDate     = [Pending GRN Snapshot Date]
			VAR MinD         = MIN ( GRNAgeBucket[MinDays] )
			VAR MaxD         = MAX ( GRNAgeBucket[MaxDays] )
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( gold_dpmc_vs_2w3w_factpendinggrn_v2[GatePassNo] ),
			    gold_dpmc_vs_2w3w_factpendinggrn_v2[DMT_LOADED_DATE] = SnapDate,
			    NOT ISBLANK ( gold_dpmc_vs_2w3w_factpendinggrn_v2[GatePassApprovedDate] ),
			    gold_dpmc_vs_2w3w_factpendinggrn_v2[GatePassApprovedDate] < SelectedDate - MinD + 1,
			    gold_dpmc_vs_2w3w_factpendinggrn_v2[GatePassApprovedDate] >= SelectedDate - MaxD
			)+0
		formatString: 0
		lineageTag: b265e411-aa85-4737-a11e-478d10059476

	measure 'Model Wise Remaining Target' =
			
			VAR Tgt = [Model Wise Target]
			VAR Act = [Model Wise Actual Units]
			RETURN
			IF ( ISBLANK ( Tgt ), BLANK (), MAX ( Tgt - Act, 0 ) )
		formatString: 0
		lineageTag: eda4a3a6-e997-441a-b4b3-944b4b75e0e2

	measure 'Stock Treemap Color' =
			
			VAR CurrentStock = [Model Wise Current Stock]
			VAR MaxStock =
			    MAXX (
			        ALLSELECTED ( gold_dpmc_vs_2w3w4w_dimproduct[Model (Sales)] ),
			        [Model Wise Current Stock]
			    )
			VAR MinStock =
			    MINX (
			        ALLSELECTED ( gold_dpmc_vs_2w3w4w_dimproduct[Model (Sales)] ),
			        [Model Wise Current Stock]
			    )
			VAR Ratio = DIVIDE ( CurrentStock - MinStock, MaxStock - MinStock, 0 )
			RETURN
			SWITCH (
			    TRUE (),
			    Ratio >= 0.75, "#2FA4C7",  -- Largest: Medium Cerulean Blue
			    Ratio >= 0.45, "#36966E",  -- Upper-Mid: Deep Emerald
			    Ratio >= 0.25, "#5EB08E",  -- Mid: Medium Sage
			    Ratio >= 0.12, "#DFC256",  -- Lower-Mid: Mustard Gold
			    Ratio >= 0.05, "#D48B4B",  -- Small: Warm Terracotta
			    "#B55E65"                  -- Smallest: Deep Dusty Crimson
			)
		lineageTag: 05fb24ad-af57-450e-bfb0-80b782f936b2

	measure 'Funnel Detail Value' =
			
			VAR HasManualDateFilter =
			    ISFILTERED ( gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[DMT_LOADED_DATE] )
			VAR LatestLoadedDate =
			    CALCULATE (
			        MAX ( gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[DMT_LOADED_DATE] ),
			        ALL ( gold_dpmc_vs_2w3w_factinquirytoinvoice_v2 )
			    )
			VAR AllocType =
			    SWITCH (
			        SELECTEDVALUE ( 'Stage'[StageName] ),
			        "Inquiry",           "INQ",
			        "Confirmed Booking", "CONFIRM",
			        "Allocation",        "ALLOCATED",
			        "Invoice",           "INVOICE"
			    )
			RETURN
			IF (
			    HasManualDateFilter,
			    CALCULATE (
			        SUM ( gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[VehicleCount] ),
			        KEEPFILTERS (
			            gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[AllocationType] = AllocType
			                || ISBLANK ( AllocType )
			        )
			    ),
			    CALCULATE (
			        SUM ( gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[VehicleCount] ),
			        KEEPFILTERS (
			            gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[AllocationType] = AllocType
			                || ISBLANK ( AllocType )
			        ),
			        gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[DMT_LOADED_DATE] = LatestLoadedDate
			    )
			)
		formatString: 0
		lineageTag: 692ab464-0dcb-4dd1-b689-6220c35b510e

	measure 'Unit Comp Value' =
			
			VAR K = SELECTEDVALUE ( UnitComp[Key] )
			RETURN
			SWITCH (
			    K,
			    "Month",   [Row Month Label],
			    "Cash",    FORMAT ( [Cum Cash Sales],       "#,0" ),
			    "Finance", FORMAT ( [Cum Finance Sales],    "#,0" ),
			    "Dealer",  FORMAT ( [Cum Dealer Count],     "#,0" ),
			    "Premise", FORMAT ( [Cum Premise Count],    "#,0" ),
			    "Total",   FORMAT ( [Cum Total Units Sold], "#,0" ),
			    "Trend",   SWITCH ( [Cum Units Trend], 1, UNICHAR ( 9650 ), -1, UNICHAR ( 9660 ), "" ),
			    BLANK ()
			)
		lineageTag: f7719857-b9f2-41b2-b68e-49857ea45032

	measure 'Unit Comp Color' =
			
			IF (
			    SELECTEDVALUE ( UnitComp[Key] ) = "Trend",
			    SWITCH ( [Cum Units Trend], 1, "#2E7D32", -1, "#C62828", "#000000" ),
			    "#000000"
			)
		lineageTag: 9b96100d-fbb9-44db-acee-2bf6776785c9

	measure 'Unit Comp Value (Completed Month)' =
			
			VAR K          = SELECTEDVALUE ( UnitComp[Key] )
			VAR AnchorDate = [Anchor Selected Date]
			VAR MB         = SELECTEDVALUE ( MonthsBackSelector[MonthsBack] )
			VAR StartDate  = EDATE ( DATE ( YEAR ( AnchorDate ), MONTH ( AnchorDate ), 1 ), -( MB + 1 ) )
			VAR EndDate    = EOMONTH ( StartDate, 0 )
			VAR PrevStart  = EDATE ( StartDate, -1 )
			VAR PrevEnd    = EOMONTH ( PrevStart, 0 )
			VAR Cash   = CALCULATE ( [Cash Sales],       REMOVEFILTERS ( gold_dpmc_dimdate ), gold_dpmc_dimdate[TheDate] >= StartDate, gold_dpmc_dimdate[TheDate] <= EndDate )
			VAR Fin    = CALCULATE ( [Finance Sales],    REMOVEFILTERS ( gold_dpmc_dimdate ), gold_dpmc_dimdate[TheDate] >= StartDate, gold_dpmc_dimdate[TheDate] <= EndDate )
			VAR Total  = CALCULATE ( [Total Units Sold], REMOVEFILTERS ( gold_dpmc_dimdate ), gold_dpmc_dimdate[TheDate] >= StartDate, gold_dpmc_dimdate[TheDate] <= EndDate )
			VAR Dealer = CALCULATE ( COUNTROWS ( gold_dpmc_vs_2w3w4w_factsales ), gold_dpmc_vs_2w3w4w_factsales[InqType] = "DEALER",  REMOVEFILTERS ( gold_dpmc_dimdate ), gold_dpmc_dimdate[TheDate] >= StartDate, gold_dpmc_dimdate[TheDate] <= EndDate )
			VAR Prem   = CALCULATE ( COUNTROWS ( gold_dpmc_vs_2w3w4w_factsales ), gold_dpmc_vs_2w3w4w_factsales[InqType] = "PREMISE", REMOVEFILTERS ( gold_dpmc_dimdate ), gold_dpmc_dimdate[TheDate] >= StartDate, gold_dpmc_dimdate[TheDate] <= EndDate )
			VAR PrevTotal = CALCULATE ( [Total Units Sold], REMOVEFILTERS ( gold_dpmc_dimdate ), gold_dpmc_dimdate[TheDate] >= PrevStart, gold_dpmc_dimdate[TheDate] <= PrevEnd )
			RETURN
			SWITCH (
			    K,
			    "Month",   FORMAT ( StartDate, "MMM-yy" ),
			    "Cash",    FORMAT ( Cash,   "#,0" ),
			    "Finance", FORMAT ( Fin,    "#,0" ),
			    "Dealer",  FORMAT ( Dealer, "#,0" ),
			    "Premise", FORMAT ( Prem,   "#,0" ),
			    "Total",   FORMAT ( Total,  "#,0" ),
			    "Trend",   SWITCH ( SIGN ( Total - PrevTotal ), 1, UNICHAR ( 9650 ), -1, UNICHAR ( 9660 ), "" ),
			    BLANK ()
			)
		lineageTag: c72851df-b36f-4b1d-af99-fca19c411e8c

	measure 'Unit Comp Value (Year)' =
			
			VAR K          = SELECTEDVALUE ( UnitCompYear[Key] )
			VAR Yr         = SELECTEDVALUE ( gold_dpmc_dimdate[TheYear] )
			VAR AnchorDate = [Anchor Selected Date]
			VAR CurrEnd    = MIN ( AnchorDate, DATE ( Yr, 12, 31 ) )
			VAR HasSales   = NOT ISBLANK ( [Total Units Sold] )
			VAR CurrTotal  =
			    CALCULATE ( [Total Units Sold], REMOVEFILTERS ( gold_dpmc_dimdate ),
			        gold_dpmc_dimdate[TheDate] >= DATE ( Yr, 1, 1 ),
			        gold_dpmc_dimdate[TheDate] <= CurrEnd )
			VAR PrevTotal  =
			    CALCULATE ( [Total Units Sold], REMOVEFILTERS ( gold_dpmc_dimdate ),
			        gold_dpmc_dimdate[TheDate] >= DATE ( Yr - 1, 1, 1 ),
			        gold_dpmc_dimdate[TheDate] <= EDATE ( CurrEnd, -12 ) )
			RETURN
			IF (
			    HasSales,
			    SWITCH (
			        K,
			        "Cash",    FORMAT ( [Cash Sales],       "#,0" ),
			        "Finance", FORMAT ( [Finance Sales],    "#,0" ),
			        "Dealer",  FORMAT ( [Dealer Count],     "#,0" ),
			        "Premise", FORMAT ( [Premise Count],    "#,0" ),
			        "Total",   FORMAT ( [Total Units Sold], "#,0" ),
			        "Trend",   SWITCH ( SIGN ( CurrTotal - PrevTotal ), 1, UNICHAR ( 9650 ), -1, UNICHAR ( 9660 ), "" ),
			        BLANK ()
			    ),
			    BLANK ()
			)
		lineageTag: fcada27b-68e5-465f-bc4c-b207b134da0f

