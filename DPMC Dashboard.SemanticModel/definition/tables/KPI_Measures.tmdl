	measure 'Sales Display Text' = ```
			
			VAR RawValue = [Sales (MTD as of Selected Date)] * 1000000
			VAR AbsValue = ABS ( RawValue )
			VAR ScaledText = 
			    SWITCH (
			        TRUE (),
			        AbsValue >= 1000000000, FORMAT ( RawValue / 1000000000, "#,##0.00" ) & " B",
			        AbsValue >= 10000000,   FORMAT ( RawValue / 1000000, "#,##0.00" ) & " M",
			        AbsValue >= 100000,     FORMAT ( RawValue / 100000, "#,##0.00" ) & " Lakh",
			        AbsValue >= 1000,       FORMAT ( RawValue / 1000, "#,##0.00" ) & " K",
			        FORMAT ( RawValue, "#,##0.00" )
			    )
			RETURN
			    "LKR " & ScaledText
			```
		lineageTag: 9dc2c212-9f98-4376-b0e2-8ca2626ec0f5

	measure 'Sales Format String' =
			
			VAR Q = UNICHAR ( 34 )
			VAR RawValue = [Sales (MTD as of Selected Date)] * 1000000
			VAR AbsValue = ABS ( RawValue )
			RETURN
			    SWITCH (
			        TRUE (),
			        AbsValue >= 1000000000, Q & "LKR " & Q & "#,##0.00,,," & Q & " B" & Q,
			        AbsValue >= 1000000,    Q & "LKR " & Q & "#,##0.00,," & Q & " M" & Q,
			        AbsValue >= 1000,       Q & "LKR " & Q & "#,##0.00," & Q & " K" & Q,
			        Q & "LKR " & Q & "#,##0.00"
			    )
		lineageTag: 574faeba-f87e-4323-b4df-fc30fbd6584b

	measure 'Sales (MTD as of Selected Date)' =
			
			VAR SelectedDate = SELECTEDVALUE ( AsOfDateSelector[SelectedDate] )
			VAR MonthStart = DATE ( YEAR ( SelectedDate ), MONTH ( SelectedDate ), 1 )
			RETURN
			    CALCULATE (
			        [Sales Value (LKR M)],
			        gold_dpmc_vs_2w3w4w_factsales[InvoiceDate] >= MonthStart,
			        gold_dpmc_vs_2w3w4w_factsales[InvoiceDate] <= SelectedDate
			    )
		lineageTag: 1def8ade-7bb7-4d24-9380-9e6e270fa03f

		formatStringDefinition = ""

	measure 'Total Bookings V2' =
			
			VAR SelectedDate = [Selected As Of Date]
			VAR MonthStart   = DATE ( YEAR ( SelectedDate ), MONTH ( SelectedDate ), 1 )
			VAR SnapDate     = [Inquiry Snapshot Date]
			RETURN
			CALCULATE (
			    SUM ( gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[VehicleCount] ),
			    gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[AllocationType] = "CONFIRM",
			    gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[DMT_LOADED_DATE] = SnapDate,
			    NOT ISBLANK ( gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[ConfirmDate] ),
			    gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[ConfirmDate] >= MonthStart,
			    gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[ConfirmDate] < SelectedDate + 1
			)
		formatString: 0
		lineageTag: c2105e6c-d94d-46af-8fff-2327f2050540

	measure 'No of Inquiries V2' =
			
			VAR SelectedDate = [Selected As Of Date]
			VAR MonthStart   = DATE ( YEAR ( SelectedDate ), MONTH ( SelectedDate ), 1 )
			VAR SnapDate     = [Inquiry Snapshot Date]
			RETURN
			CALCULATE (
			    SUM ( gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[VehicleCount] ),
			    gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[AllocationType] = "INQ",
			    gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[DMT_LOADED_DATE] = SnapDate,
			    NOT ISBLANK ( gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[InquiryDate] ),
			    gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[InquiryDate] >= MonthStart,
			    gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[InquiryDate] < SelectedDate + 1
			)
		formatString: 0
		lineageTag: f91480c8-8e4d-46ae-b959-da22dc04bf9d

	measure 'Target (Selected Month)' =
			
			VAR SelectedDate = SELECTEDVALUE ( AsOfDateSelector[SelectedDate] )
			VAR MonthStart = DATE ( YEAR ( SelectedDate ), MONTH ( SelectedDate ), 1 )
			VAR MonthEnd = EOMONTH ( MonthStart, 0 )
			RETURN
			    CALCULATE (
			        [Target (Selected)],
			        gold_dpmc_dimdate[TheDate] >= MonthStart,
			        gold_dpmc_dimdate[TheDate] <= MonthEnd
			    )
		formatString: 0
		lineageTag: ad9bc42e-c52d-4bcc-a86c-697b57642296

	measure 'Remaining Target (MTD as of Selected Date)' =
			
			[Target (Selected Month)] - [Sales (MTD as of Selected Date)]
		formatString: 0
		lineageTag: fc28f729-ac8b-4e15-8d51-df58bff54d84

