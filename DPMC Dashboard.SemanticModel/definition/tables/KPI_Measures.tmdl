	measure 'Avg Pending Days' =
			
			VAR SelectedDate = [Selected As Of Date]
			VAR SnapDate     = [Pending GRN Snapshot Date]
			RETURN
			AVERAGEX (
			    FILTER (
			        gold_dpmc_vs_2w3w_factpendinggrn_v2,
			        gold_dpmc_vs_2w3w_factpendinggrn_v2[DMT_LOADED_DATE] = SnapDate
			            && NOT ISBLANK ( gold_dpmc_vs_2w3w_factpendinggrn_v2[GatePassApprovedDate] )
			    ),
			    DATEDIFF ( gold_dpmc_vs_2w3w_factpendinggrn_v2[GatePassApprovedDate], SelectedDate, DAY )
			)
		lineageTag: 2e60e1a6-73bd-4cc3-980f-6ea4f275bf9e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pending Days' =
			
			VAR SelectedDate = [Selected As Of Date]
			VAR SnapDate     = [Pending GRN Snapshot Date]
			VAR Approved =
			    CALCULATE (
			        MAX ( gold_dpmc_vs_2w3w_factpendinggrn_v2[GatePassApprovedDate] ),
			        gold_dpmc_vs_2w3w_factpendinggrn_v2[DMT_LOADED_DATE] = SnapDate
			    )
			RETURN
			    IF ( NOT ISBLANK ( Approved ), DATEDIFF ( Approved, SelectedDate, DAY ) )
		formatString: 0
		lineageTag: c601198c-1d1c-4e15-aae5-0484bded79a8

