	measure 'Inquiry Snapshot Date' =
			
			VAR SelectedDate = [Selected As Of Date]
			VAR Snap =
			    CALCULATE (
			        MAX ( gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[DMT_LOADED_DATE] ),
			        ALL ( gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[DMT_LOADED_DATE] ),
			        gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[DMT_LOADED_DATE] < SelectedDate + 1
			    )
			RETURN
			IF (
			    ISBLANK ( Snap ),
			    CALCULATE (
			        MIN ( gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[DMT_LOADED_DATE] ),
			        ALL ( gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[DMT_LOADED_DATE] )
			    ),
			    Snap
			)
		formatString: General Date
