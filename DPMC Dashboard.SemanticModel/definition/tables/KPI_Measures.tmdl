			CALCULATE (
			    MAX ( gold_dpmc_vs_2w3w_factpendinggrn_v2[DMT_LOADED_DATE] ),
			    ALL ( gold_dpmc_vs_2w3w_factpendinggrn_v2[DMT_LOADED_DATE] ),
