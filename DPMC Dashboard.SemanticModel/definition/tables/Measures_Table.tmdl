	measure 'Funnel Inquiry' =
			
			VAR HasManualDateFilter =
			    ISFILTERED ( gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[DMT_LOADED_DATE] )
			VAR LatestLoadedDate =
			    CALCULATE (
			        MAX ( gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[DMT_LOADED_DATE] ),
			        ALL ( gold_dpmc_vs_2w3w_factinquirytoinvoice_v2 )
			    )
			RETURN
			    IF (
			        HasManualDateFilter,
			        CALCULATE (
			            SUM ( gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[VehicleCount] ),
			            gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[AllocationType] = "INQ"
			        ),
			        CALCULATE (
			            SUM ( gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[VehicleCount] ),
			            gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[AllocationType] = "INQ",
			            gold_dpmc_vs_2w3w_factinquirytoinvoice_v2[DMT_LOADED_DATE] = LatestLoadedDate
			        )
			    )
		formatString: 0
		lineageTag: dd8bafa2-0d72-4bca-9d45-f3daa89ca0d7

