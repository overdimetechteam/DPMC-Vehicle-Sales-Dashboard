	measure 'Cum Units Trend' =
			
			VAR AnchorDate       = [Anchor Selected Date]
			VAR AnchorMonthStart = DATE ( YEAR ( AnchorDate ), MONTH ( AnchorDate ), 1 )
			VAR N                = [Anchor Working Day N]
			VAR MB               = SELECTEDVALUE ( MonthsBackSelector[MonthsBack] )
			VAR CurrTotal        = [Cum Total Units Sold]
			VAR PrevStart        = EDATE ( AnchorMonthStart, -( MB + 1 ) )
			VAR PrevEnd          = EDATE ( PrevStart, 1 )
			VAR PrevTarget =
			    CALCULATE (
			        MIN ( WorkingDayLookup[Date] ),
			        WorkingDayLookup[Date] >= PrevStart,
			        WorkingDayLookup[Date] < PrevEnd,
			        WorkingDayLookup[WorkingDayOfMonth] = N
			    )
			VAR PrevTotal =
			    IF (
			        NOT ISBLANK ( PrevTarget ),
			        CALCULATE (
			            [Total Units Sold],
			            REMOVEFILTERS ( gold_dpmc_dimdate ),
			            gold_dpmc_dimdate[TheDate] >= PrevStart,
			            gold_dpmc_dimdate[TheDate] <= PrevTarget
			        )
			    )
			VAR Diff = CurrTotal - PrevTotal
			RETURN
			IF ( ISBLANK ( CurrTotal ) || ISBLANK ( PrevTotal ) || Diff = 0, BLANK (), SIGN ( Diff ) )
		formatString: 0
		lineageTag: 7637d6c9-8d9a-4b62-af99-dea256940f92

	measure 'Pending Booking Detail Value' =
			
			VAR _SelectedDate =
			    SELECTEDVALUE ( AsOfDateSelector[SelectedDate], MAX ( AsOfDateSelector[SelectedDate] ) )
			RETURN
			CALCULATE (
			    SUM ( gold_dpmc_vs_2w3w_factpendingbooking_v2[VehicleCount] ),
			    KEEPFILTERS ( gold_dpmc_vs_2w3w_factpendingbooking_v2[DMT_LOADED_DATE] = _SelectedDate ),
			    KEEPFILTERS ( gold_dpmc_vs_2w3w_factpendingbooking_v2[AllocationType] IN { "ALLOCATED", "NOT ALLOCATED" } )
			)
		lineageTag: 427ab75f-b71c-48bd-a2c5-0578359b2b2a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column
		formatString: 0
		lineageTag: 194b6994-0780-4091-9b5f-56fdb64ff5df
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition Measures_Table = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = ea8fd3edbc174c8ea1108c5301fade10

	annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":null}

