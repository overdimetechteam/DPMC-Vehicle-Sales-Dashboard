	column Age_GRN_Bucket = ```
			
			VAR AgeDays = gold_dpmc_vs_2w3w_factpendinggrn_v2[Pending Days]
			    
			RETURN
			SWITCH(
			    TRUE(),
			   
			    AgeDays <= 5, "0-5 Days",
			    AgeDays <= 30, "6-30 Days",
			    AgeDays <= 60, "31-60 Days",
			    AgeDays <= 90, "61-90 Days",
			    AgeDays <= 120, "91-120 Days",
			    AgeDays <= 150, "121-150 Days",
			    AgeDays <= 180, "151-180 Days",
			    "Above 6 Months"
			)
			```
		lineageTag: 523be70d-d4c7-426f-86a6-12bc84d509c8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

