	measure 'Target (Selected Month)' =
			
			VAR SelectedDate = SELECTEDVALUE ( AsOfDateSelector[SelectedDate] )
			VAR MonthStart = DATE ( YEAR ( SelectedDate ), MONTH ( SelectedDate ), 1 )
			VAR MonthEnd = EOMONTH ( MonthStart, 0 )
			RETURN
			    CALCULATE (
			        [Target (Selected)],
			        gold_dpmc_dimdate[TheDate] >= MonthStart,
			        gold_dpmc_dimdate[TheDate] <= MonthEnd
			    )
		formatString: 0
		lineageTag: ad9bc42e-c52d-4bcc-a86c-697b57642296

	measure 'Remaining Target (MTD as of Selected Date)' =
			
			[Target (Selected Month)] - [Sales (MTD as of Selected Date)]
		lineageTag: fc28f729-ac8b-4e15-8d51-df58bff54d84

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Achievement Ring SVG' = ```
			
			VAR Actual = [Sales (MTD as of Selected Date)]
			VAR Target = [Target (Selected Month)]
			VAR Remaining = [Remaining Target (MTD as of Selected Date)]
			VAR AchPct = DIVIDE ( Actual, Target )
			VAR AchPctDisplay = FORMAT ( AchPct, "0%" )
			VAR Circumference = 282.74
			VAR ProgressLength = Circumference * AchPct
			VAR ActualDisplay = "LKR " & FORMAT ( Actual, "#,##0.0" ) & "M"
			VAR TargetDisplay = "LKR " & FORMAT ( Target, "#,##0.0" ) & "M"
			VAR RemainingDisplay = "LKR " & FORMAT ( Remaining, "#,##0.0" ) & "M"
			VAR SVGString = 
			    "<svg xmlns='http://www.w3.org/2000/svg' width='400' height='160' viewBox='0 0 400 160'>" &
			    "<rect x='0' y='0' width='400' height='160' rx='12' fill='#ffffff'/>" &
			    "<circle cx='85' cy='80' r='45' fill='none' stroke='#e9e6fb' stroke-width='10'/>" &
			    "<circle cx='85' cy='80' r='45' fill='none' stroke='#6c4ce6' stroke-width='10' stroke-linecap='round' stroke-dasharray='" & FORMAT(ProgressLength,"0.0") & " " & FORMAT(Circumference,"0.0") & "' transform='rotate(-90 85 80)'/>" &
			    "<text x='85' y='78' text-anchor='middle' font-size='22' font-weight='bold' font-family='Segoe UI' fill='#1f2937'>" & AchPctDisplay & "</text>" &
			    "<text x='85' y='96' text-anchor='middle' font-size='10' font-family='Segoe UI' fill='#6b7280'>of target</text>" &
			    "<text x='180' y='30' font-size='12' font-family='Segoe UI' font-weight='bold' fill='#6b7280'>TOTAL SALES</text>" &
			    "<text x='180' y='60' font-size='24' font-family='Segoe UI' font-weight='bold' fill='#111827'>" & ActualDisplay & "</text>" &
			    "<line x1='180' y1='75' x2='380' y2='75' stroke='#e5e7eb' stroke-width='1'/>" &
			    "<text x='180' y='95' font-size='12' font-family='Segoe UI' fill='#6b7280'>TARGET</text>" &
			    "<text x='380' y='95' text-anchor='end' font-size='12' font-family='Segoe UI' font-weight='bold' fill='#111827'>" & TargetDisplay & "</text>" &
			    "<text x='180' y='115' font-size='12' font-family='Segoe UI' fill='#6b7280'>REMAINING</text>" &
			    "<text x='380' y='115' text-anchor='end' font-size='12' font-family='Segoe UI' font-weight='bold' fill='#111827'>" & RemainingDisplay & "</text>" &
			    "</svg>"
			VAR EncodedSVG = SUBSTITUTE ( SUBSTITUTE ( SVGString, "#", "%23" ), " ", "%20" )
			RETURN
			    "data:image/svg+xml;utf8," & EncodedSVG
			```
		lineageTag: 3f283923-4372-48fa-9ef6-6fea7ab8b5d1

	measure 'Sales Achievement Ring HTML' =
			
			VAR SelectedDate = SELECTEDVALUE ( AsOfDateSelector[SelectedDate] )
			VAR MonthStart = DATE ( YEAR ( SelectedDate ), MONTH ( SelectedDate ), 1 )
			VAR SelectedType = SELECTEDVALUE ( VehicleTypeSelector[Vehicle Type] )
			VAR Q = UNICHAR ( 34 )
			VAR Actual =
			    SWITCH (
			        SelectedType,
			        "2W", CALCULATE (
			                  DISTINCTCOUNT ( gold_dpmc_vs_2w3w4w_factsales[ChassisNo] ),
			                  NOT ISBLANK ( gold_dpmc_vs_2w3w4w_factsales[InvoiceNo] ),
			                  gold_dpmc_vs_2w3w4w_dimproduct[STR_PRODLINE_DESC] = "2 WHEELERS",
			                  gold_dpmc_vs_2w3w4w_factsales[InvoiceDate] >= MonthStart,
			                  gold_dpmc_vs_2w3w4w_factsales[InvoiceDate] <= SelectedDate
			              ),
			        "3W", CALCULATE (
			                  DISTINCTCOUNT ( gold_dpmc_vs_2w3w4w_factsales[ChassisNo] ),
			                  NOT ISBLANK ( gold_dpmc_vs_2w3w4w_factsales[InvoiceNo] ),
			                  gold_dpmc_vs_2w3w4w_dimproduct[STR_PRODLINE_DESC] = "3 WHEELERS",
			                  gold_dpmc_vs_2w3w4w_factsales[InvoiceDate] >= MonthStart,
			                  gold_dpmc_vs_2w3w4w_factsales[InvoiceDate] <= SelectedDate
			              ),
			        CALCULATE (
			            DISTINCTCOUNT ( gold_dpmc_vs_2w3w4w_factsales[ChassisNo] ),
			            NOT ISBLANK ( gold_dpmc_vs_2w3w4w_factsales[InvoiceNo] ),
			            gold_dpmc_vs_2w3w4w_dimproduct[STR_PRODLINE_DESC] IN { "2 WHEELERS", "3 WHEELERS" },
			            gold_dpmc_vs_2w3w4w_factsales[InvoiceDate] >= MonthStart,
			            gold_dpmc_vs_2w3w4w_factsales[InvoiceDate] <= SelectedDate
			        )
			    )
			VAR Target = [Target (Selected Month)]
			VAR Remaining = Target - Actual
			VAR AchPct = DIVIDE ( Actual, Target )
			VAR AchPctDisplay = FORMAT ( AchPct, "0%" )
			VAR Circumference = 282.74
			VAR ProgressLength = Circumference * AchPct
			VAR ActualDisplay = FORMAT ( Actual, "#,##0" )
			VAR TargetDisplay = FORMAT ( Target, "#,##0" )
			VAR RemainingDisplay = FORMAT ( Remaining, "#,##0" )
			RETURN
			"<div style=" & Q & "display:flex;align-items:center;font-family:Segoe UI,sans-serif;background:#fff;border-radius:12px;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,0.08);" & Q & ">" &
			  "<svg width=" & Q & "130" & Q & " height=" & Q & "130" & Q & " viewBox=" & Q & "0 0 100 100" & Q & ">" &
			    "<circle cx=" & Q & "50" & Q & " cy=" & Q & "50" & Q & " r=" & Q & "45" & Q & " fill=" & Q & "none" & Q & " stroke=" & Q & "#e9e6fb" & Q & " stroke-width=" & Q & "10" & Q & "/>" &
			    "<circle cx=" & Q & "50" & Q & " cy=" & Q & "50" & Q & " r=" & Q & "45" & Q & " fill=" & Q & "none" & Q & " stroke=" & Q & "#6c4ce6" & Q & " stroke-width=" & Q & "10" & Q & " stroke-linecap=" & Q & "round" & Q & " stroke-dasharray=" & Q & FORMAT(ProgressLength,"0.0") & " " & FORMAT(Circumference,"0.0") & Q & " transform=" & Q & "rotate(-90 50 50)" & Q & "/>" &
			    "<text x=" & Q & "50" & Q & " y=" & Q & "48" & Q & " text-anchor=" & Q & "middle" & Q & " font-size=" & Q & "20" & Q & " font-weight=" & Q & "bold" & Q & " fill=" & Q & "#1f2937" & Q & ">" & AchPctDisplay & "</text>" &
			    "<text x=" & Q & "50" & Q & " y=" & Q & "62" & Q & " text-anchor=" & Q & "middle" & Q & " font-size=" & Q & "8" & Q & " fill=" & Q & "#6b7280" & Q & ">of target</text>" &
			  "</svg>" &
			  "<div style=" & Q & "margin-left:20px;" & Q & ">" &
			    "<div style=" & Q & "font-size:12px;color:#6b7280;font-weight:600;letter-spacing:0.5px;" & Q & ">TOTAL UNITS SOLD</div>" &
			    "<div style=" & Q & "font-size:26px;font-weight:bold;color:#111827;margin-bottom:8px;" & Q & ">" & ActualDisplay & "</div>" &
			    "<div style=" & Q & "border-top:1px solid #e5e7eb;padding-top:8px;font-size:12px;" & Q & ">" &
			      "<div style=" & Q & "display:flex;justify-content:space-between;color:#6b7280;" & Q & "><span>TARGET </span><span style=" & Q & "color:#111827;font-weight:600;" & Q & ">" & TargetDisplay & "</span></div>" &
			      "<div style=" & Q & "display:flex;justify-content:space-between;color:#6b7280;margin-top:4px;" & Q & "><span>REMAINING </span><span style=" & Q & "color:#111827;font-weight:600;" & Q & ">" & RemainingDisplay & "</span></div>" &
			    "</div>" &
			  "</div>" &
			"</div>"
		lineageTag: e07c37f7-86ae-457d-b523-4dcbba6c49f4

