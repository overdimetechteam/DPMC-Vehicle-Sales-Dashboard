	column 'Days Pending Bucket' =
			
			VAR d = DATEDIFF(gold_dpmc_vs_2w3w4w_factinquiry[InquiryDate], TODAY(), DAY)
			RETURN
			    SWITCH(
			        TRUE(),
			        NOT gold_dpmc_vs_2w3w4w_factinquiry[Type] IN {"INQ", "CONFIRM", "ALLOCATE"}, BLANK(),
			        d <= 30, "0-30 days",
			        d <= 60, "31-60 days",
			        d <= 80, "61-80 days",
			        "81 days above"
			    )
		lineageTag: 1ac6a1bc-ccb6-4b3b-a73e-2ae091adf02e
		summarizeBy: none
		sortByColumn: 'Days Pending Bucket Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Days Pending Bucket Sort' =
			
			VAR d = DATEDIFF(gold_dpmc_vs_2w3w4w_factinquiry[InquiryDate], TODAY(), DAY)
			RETURN
			    SWITCH(
			        TRUE(),
			        NOT gold_dpmc_vs_2w3w4w_factinquiry[Type] IN {"INQ", "CONFIRM", "ALLOCATE"}, BLANK(),
			        d <= 30, 1,
			        d <= 60, 2,
			        d <= 80, 3,
			        4
			    )
		formatString: 0
		lineageTag: 609571f1-5852-4c5e-8300-77340ef274a3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

