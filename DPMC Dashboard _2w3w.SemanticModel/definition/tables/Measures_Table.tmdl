	measure 'Funnel Value' =
			
			VAR CurrentStage =
			    SELECTEDVALUE(
			        'Stage'[StageName]
			    )
			RETURN
			    SWITCH(
			        CurrentStage,
			        "Inquiry",    [Funnel Inquiry],
			        "Confirmed Booking",    [Funnel Booking],
			        "Allocation", [Funnel Allocation],
			        "Invoice",    [Funnel Invoice],
			        BLANK()
			    )
		formatString: 0
		lineageTag: 2565c278-5108-41ae-a8a2-16186854b747

	measure 'Selected Date' =
			
			COALESCE(
			    SELECTEDVALUE(
			        gold_dpmc_dimdate[TheDate]
			    ),
			    TODAY() - 1
			)
		formatString: General Date
		lineageTag: 2eb42069-581b-45fa-9211-8c2982dbcd6f

	measure 'Yesterday Stock' =
			
			CALCULATE(
			    DISTINCTCOUNTNOBLANK(
			        gold_dpmc_vs_2w3w4w_factstock[ChassisNo]
			    ),
			    gold_dpmc_vs_2w3w4w_factstock[CurrentStock] = 1,
			    gold_dpmc_vs_2w3w4w_factstock[Status] <> "INVOICE"
			)
		formatString: 0
		lineageTag: 73e9ea71-de2f-4531-98e1-e4b6788e32f6

	measure Measure
		lineageTag: 8f89f001-8e1d-4dc0-a0cf-65b26f0d2118

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Selected Date Stock' =
			
			VAR SelectedDate =
			    [Selected Date]
			
			VAR EligibleStock =
			    FILTER(
			        gold_dpmc_vs_2w3w4w_factstock,
			        gold_dpmc_vs_2w3w4w_factstock[CurrentStock] IN { 0, 1 }
			            && gold_dpmc_vs_2w3w4w_factstock[Status] <> "INVOICE"
			            && gold_dpmc_vs_2w3w4w_factstock[GRNDate] <= SelectedDate
			            &&
			            (
			                gold_dpmc_vs_2w3w4w_factstock[DeliveryDate] > SelectedDate
			                    || gold_dpmc_vs_2w3w4w_factstock[CalMaxDate] >= SelectedDate
			            )
			    )
			
			VAR LatestEligibleRows =
			    FILTER(
			        EligibleStock,
			        VAR CurrentChassis =
			            gold_dpmc_vs_2w3w4w_factstock[ChassisNo]
			        VAR CurrentLoadedDate =
			            gold_dpmc_vs_2w3w4w_factstock[DMT_LOADED_DATE]
			        VAR LatestLoadedDate =
			            MAXX(
			                FILTER(
			                    EligibleStock,
			                    gold_dpmc_vs_2w3w4w_factstock[ChassisNo] = CurrentChassis
			                ),
			                gold_dpmc_vs_2w3w4w_factstock[DMT_LOADED_DATE]
			            )
			        RETURN
			            CurrentLoadedDate = LatestLoadedDate
			    )
			
			RETURN
			    COUNTROWS(
			        SUMMARIZE(
			            LatestEligibleRows,
			            gold_dpmc_vs_2w3w4w_factstock[ChassisNo]
			        )
			    )
		formatString: 0
		lineageTag: 0d741b50-f816-4b05-8b02-70f8a8dda4bd

	measure 'Current Stock' =
			
			VAR SelectedDate =
			    [Selected Date]
			RETURN
			    IF(
			        SelectedDate = TODAY() - 1,
			        [Yesterday Stock],
			        [Selected Date Stock]
			    )
		formatString: 0
		lineageTag: e73165ea-db64-46d7-97d0-1ccec0acf120

	measure 'Funnel Inquiry' =
			
			VAR HasManualDateFilter = ISFILTERED ( gold_dpmc_vs_2w3w4w_factinquiry[InquiryDate] )
			VAR EndDate = [Selected As Of Date]
			VAR ThreeMonthsBack = EDATE ( EndDate, -3 )
			VAR StartDate = DATE ( YEAR ( ThreeMonthsBack ), MONTH ( ThreeMonthsBack ), 1 )
			RETURN
			    IF (
			        HasManualDateFilter,
			        CALCULATE ( COUNT ( gold_dpmc_vs_2w3w4w_factinquiry[InquiryNo] ), gold_dpmc_vs_2w3w4w_factinquiry[Type] = "INQ" ),
			        CALCULATE (
			            COUNT ( gold_dpmc_vs_2w3w4w_factinquiry[InquiryNo] ),
			            gold_dpmc_vs_2w3w4w_factinquiry[Type] = "INQ",
			            gold_dpmc_vs_2w3w4w_factinquiry[InquiryDate] >= StartDate,
			            gold_dpmc_vs_2w3w4w_factinquiry[InquiryDate] <= EndDate
			        )
			    )
		formatString: 0
		lineageTag: dd8bafa2-0d72-4bca-9d45-f3daa89ca0d7

