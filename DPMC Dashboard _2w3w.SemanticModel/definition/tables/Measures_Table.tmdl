	measure 'Row Month Label' = VAR AnchorDate = [Anchor Selected Date] VAR AnchorMonthStart = DATE(YEAR(AnchorDate), MONTH(AnchorDate), 1) VAR MonthsBack = SELECTEDVALUE(MonthsBackSelector[MonthsBack]) RETURN FORMAT(EDATE(AnchorMonthStart, -MonthsBack), "MMM-yy")
		lineageTag: f5230739-9421-4751-9276-77b4be079fe2

	measure 'Anchor Selected Date' =
			
			COALESCE(
			    SELECTEDVALUE(AsOfDateSelector[SelectedDate]),
			    TODAY() - 1
			)
		formatString: General Date
		lineageTag: 2433db57-ae8c-4952-91ac-b19d8e6e422a

	measure 'SameDay Total Units Trend' =
			
			VAR CurrentMonthsBack = SELECTEDVALUE(MonthsBackSelector[MonthsBack])
			VAR HasPrevRow =
			    CALCULATE(COUNTROWS(MonthsBackSelector), REMOVEFILTERS(MonthsBackSelector), MonthsBackSelector[MonthsBack] = CurrentMonthsBack + 1) > 0
			VAR CurrentTotal = [SameDay Total Units Sold]
			VAR PrevTotal =
			    IF(
			        HasPrevRow,
			        CALCULATE(
			            [SameDay Total Units Sold],
			            REMOVEFILTERS(MonthsBackSelector),
			            MonthsBackSelector[MonthsBack] = CurrentMonthsBack + 1
			        )
			    )
			VAR Diff = CurrentTotal - PrevTotal
			RETURN
			IF(ISBLANK(PrevTotal) || Diff = 0, BLANK(), SIGN(Diff))
		formatString: 0
		lineageTag: 21d30c23-c4d7-49fe-9c80-9550510beeb6

