	measure 'Show In Last3Months' =
			
			VAR SelectedDate = COALESCE ( SELECTEDVALUE ( AsOfDateSelector[SelectedDate] ), TODAY () )
			VAR ThisMonth = SELECTEDVALUE ( gold_dpmc_dimdate[TheFirstOfMonth] )
			VAR CurrentMonthStart = DATE ( YEAR ( SelectedDate ), MONTH ( SelectedDate ), 1 )
			VAR IsCompletedMonth = ThisMonth < CurrentMonthStart
			VAR HasTarget = NOT ISBLANK ( [Target (Selected)] )
			VAR RankPosition =
			    COUNTROWS (
			        FILTER (
			            MonthsWithTargetTable,
			            MonthsWithTargetTable[TheFirstOfMonth] >= ThisMonth
			        )
			    )
			RETURN
			    IF ( IsCompletedMonth && HasTarget && RankPosition <= 3, 1, 0 )
		formatString: 0
		lineageTag: a9a14a19-6682-4257-85cb-118752b65752

	measure 'Sales Last Month (MTD)' = ```
			
			VAR SelectedDate = SELECTEDVALUE ( AsOfDateSelector[SelectedDate] )
			VAR MonthStart = DATE ( YEAR ( SelectedDate ), MONTH ( SelectedDate ), 1 )
			VAR DaysElapsed = DAY ( SelectedDate ) - 1
			VAR LastMonthStart = EDATE ( MonthStart, -1 )
			VAR LastMonthCutoff = 
			    MIN ( LastMonthStart + DaysElapsed - 1, EOMONTH ( LastMonthStart, 0 ) )
			RETURN
			    CALCULATE (
			        [Sales Value (LKR M)],
			        gold_dpmc_dimdate[TheDate] >= LastMonthStart,
			        gold_dpmc_dimdate[TheDate] <= LastMonthCutoff
			    )
			```
		lineageTag: a6e6469c-dfb4-44ef-b5e8-827e88387393

		annotation PBI_FormatHint = {"isGeneralNumber":true}

