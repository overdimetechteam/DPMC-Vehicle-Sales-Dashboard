	measure 'Gauge HTML' =
			
			VAR PctVal = [Achievement %]
			VAR ScaleMax = 120
			
			VAR ClampedPct =
			    MIN ( MAX ( PctVal, 0 ), ScaleMax )
			
			VAR NeedleDeg =
			    ( ClampedPct / ScaleMax ) * 180 - 90
			
			VAR ActualTxt =
			    FORMAT ( [Actual Units], "#,##0" )
			
			VAR TargetTxt =
			    FORMAT ( [Target (Selected)], "#,##0" )
			
			VAR RemainingTxt =
			    FORMAT ( [Remaining Target], "#,##0" )
			
			VAR PctTxt =
			    FORMAT ( PctVal, "0.0" ) & "%"
			
			VAR NeedleDegTxt =
			    FORMAT ( NeedleDeg, "0.0" )
			
			RETURN
			
			"<div style=""width:280px;margin:0 auto;font-family:Segoe UI,sans-serif;text-align:center;"">"
			
			&
			
			"<div style=""position:relative;width:260px;height:145px;margin:0 auto;overflow:hidden;"">"
			
			&
			
			/* Gauge background */
			"<div style=""
			position:absolute;
			width:260px;
			height:260px;
			left:0;
			top:0;
			border-radius:50%;
			background:conic-gradient(
			from 270deg,
			#d03b3b 0deg 72deg,
			#fab219 72deg 135deg,
			#0ca30c 135deg 180deg,
			transparent 180deg 360deg
			);
			""></div>"
			
			&
			
			/* Inner circle */
			"<div style=""
			position:absolute;
			width:160px;
			height:160px;
			left:50px;
			top:50px;
			border-radius:50%;
			background:#ffffff;
			""></div>"
			
			&
			
			/* Percentage */
			"<div style=""
			position:absolute;
			left:0;
			right:0;
			top:72px;
			font-size:27px;
			font-weight:700;
			color:#1a1a1a;
			z-index:5;
			"">"
			& PctTxt &
			"</div>"
			
			&
			
			/* Needle */
			"<div style=""
			position:absolute;
			left:129px;
			bottom:0;
			width:3px;
			height:100px;
			background:#222;
			transform-origin:bottom center;
			transform:rotate("
			& NeedleDegTxt &
			"deg);
			border-radius:3px;
			z-index:6;
			""></div>"
			
			&
			
			/* Needle center */
			"<div style=""
			position:absolute;
			left:124px;
			bottom:-2px;
			width:13px;
			height:13px;
			border-radius:50%;
			background:#222;
			z-index:7;
			""></div>"
			
			&
			
			"</div>"
			
			&
			
			/* Scale labels */
			"<div style=""
			display:flex;
			justify-content:space-between;
			padding:0 8px;
			margin-top:-2px;
			font-size:10px;
			color:#777;
			"">"
			
			& "<span>0%</span>"
			& "<span>60%</span>"
			& "<span>90%</span>"
			& "<span>120%</span>"
			
			& "</div>"
			
			&
			
			/* KPI row */
			"<div style=""
			display:flex;
			justify-content:center;
			gap:22px;
			margin-top:7px;
			font-size:12px;
			"">"
			
			& "<div>"
			& "<span style=""color:#777;"">Actual</span><br>"
			& "<b style=""font-size:15px;color:#1a1a1a;"">"
			& ActualTxt
			& "</b>"
			& "</div>"
			
			& "<div>"
			& "<span style=""color:#777;"">Target</span><br>"
			& "<b style=""font-size:15px;color:#1a1a1a;"">"
			& TargetTxt
			& "</b>"
			& "</div>"
			
			& "</div>"
			
			&
			
			/* Remaining target */
			"<div style=""
			margin:7px auto 0;
			padding:5px 12px;
			display:inline-block;
			background:#f5f5f2;
			border-radius:12px;
			font-size:11px;
			color:#666;
			"">"
			
			& "Remaining "
			& "<b style=""color:#1a1a1a;font-size:12px;"">"
			& RemainingTxt
			& "</b>"
			
			& "</div>"
			
			& "</div>"
		lineageTag: 98965685-cba9-463e-86dc-6208e7fb5a8a

