	measure 'Actual Units Trend' = ```
			
			VAR CurrentMonthDate = SELECTEDVALUE ( gold_dpmc_dimdate[MonthDate] )  -- swap for your actual month field
			VAR PrevMonthDate = EDATE ( CurrentMonthDate, -1 )
			VAR PrevMonthEnd = EOMONTH ( PrevMonthDate, 0 )
			VAR PrevMonthStart = DATE ( YEAR ( PrevMonthDate ), MONTH ( PrevMonthDate ), 1 )
			
			VAR CurrentActual = [Actual Units]  -- your existing measure for this row's month
			
			VAR PreviousActual = 
			    CALCULATE (
			        DISTINCTCOUNT ( gold_dpmc_vs_2w3w4w_factsales[ChassisNo] ),
			        NOT ISBLANK ( gold_dpmc_vs_2w3w4w_factsales[InvoiceNo] ),
			        gold_dpmc_vs_2w3w4w_factsales[InvoiceDate] >= PrevMonthStart,
			        gold_dpmc_vs_2w3w4w_factsales[InvoiceDate] <= PrevMonthEnd
			    )
			
			RETURN
			SIGN ( CurrentActual - PreviousActual )
