	measure 'KPI Metrices (HTML)' =
			
			VAR SalesValue = [Sales Value (LKR M)]
			VAR StockUnits = [Stock Units]
			VAR Bookings = [Total Bookings]
			VAR Inquiries = [No of Inquiries]
			VAR GRNCount = [GRNs]
			VAR DN = [Delivery Notes]
			VAR ConfirmedB = [Confirmed Bookings]
			VAR PendingB = [Pending Bookings]
			
			VAR Style =
			"<style>
			  .kpi-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:12px; font-family:'Segoe UI',sans-serif;}
			  @media (max-width:520px){ .kpi-grid{grid-template-columns:repeat(2,1fr);} }
			  .kpi{background:#152540; border:1px solid #2A3F63; border-radius:14px; padding:14px 16px;
			    display:flex; flex-direction:column; gap:6px; transition:transform .18s ease, border-color .18s ease;}
			  .kpi:hover{transform:translateY(-2px); border-color:#3A5488;}
			  .kpi .label{font-size:11px; color:#93A5C4; text-transform:uppercase; letter-spacing:.5px; font-weight:600;}
			  .kpi .value{font-family:Consolas,'IBM Plex Mono',monospace; font-weight:700; font-size:24px; color:#EEF3FB;}
			</style>"
			
			VAR Card1 = "<div class='kpi'><div class='label'>Sales Value</div><div class='value'>" & FORMAT ( SalesValue, "#,##0.0" ) & "M</div></div>"
			VAR Card2 = "<div class='kpi'><div class='label'>Stock Units</div><div class='value'>" & FORMAT ( StockUnits, "#,##0" ) & "</div></div>"
			VAR Card3 = "<div class='kpi'><div class='label'>Bookings</div><div class='value'>" & FORMAT ( Bookings, "#,##0" ) & "</div></div>"
			VAR Card4 = "<div class='kpi'><div class='label'>Inquiries</div><div class='value'>" & FORMAT ( Inquiries, "#,##0" ) & "</div></div>"
			VAR Card5 = "<div class='kpi'><div class='label'>GRNs</div><div class='value'>" & FORMAT ( GRNCount, "#,##0" ) & "</div></div>"
			VAR Card6 = "<div class='kpi'><div class='label'>Delivery Notes</div><div class='value'>" & FORMAT ( DN, "#,##0" ) & "</div></div>"
			VAR Card7 = "<div class='kpi'><div class='label'>Confirmed Bookings</div><div class='value'>" & FORMAT ( ConfirmedB, "#,##0" ) & "</div></div>"
			VAR Card8 = "<div class='kpi'><div class='label'>Pending Bookings</div><div class='value'>" & FORMAT ( PendingB, "#,##0" ) & "</div></div>"
			
			RETURN
			Style & "<div class='kpi-grid'>" & Card1 & Card2 & Card3 & Card4 & Card5 & Card6 & Card7 & Card8 & "</div>"
		lineageTag: d6a49a0a-53c2-48d4-aabc-6a37ec5ce7df

	measure 'Next Daily Target' = ```
			
			VAR SelectedDate = SELECTEDVALUE ( AsOfDateSelector[SelectedDate] )
			VAR CutoffDate = SelectedDate - 1
			VAR MonthStart = DATE ( YEAR ( SelectedDate ), MONTH ( SelectedDate ), 1 )
			VAR MonthEndDate = EOMONTH ( SelectedDate, 0 )
			VAR SelectedType = SELECTEDVALUE ( VehicleTypeSelector[Vehicle Type])
			
			VAR BranchCodes = 
			    CALCULATETABLE (
			        VALUES ( gold_dpmc_vs_2w3w_target[STR_BRANCH] ),
			        gold_dpmc_vs_2w3w_target[DATE] = MonthEndDate
			    )
			
			VAR TargetUnits = 
			    SWITCH (
			        SelectedType,
			        "2W", CALCULATE ( SUM ( gold_dpmc_vs_2w3w_target[2WTarget] ), gold_dpmc_vs_2w3w_target[DATE] = MonthEndDate ),
			        "3W", CALCULATE ( SUM ( gold_dpmc_vs_2w3w_target[3WTarget] ), gold_dpmc_vs_2w3w_target[DATE] = MonthEndDate ),
			        CALCULATE ( SUM ( gold_dpmc_vs_2w3w_target[2WTarget] ) + SUM ( gold_dpmc_vs_2w3w_target[3WTarget] ), gold_dpmc_vs_2w3w_target[DATE] = MonthEndDate )
			    )
			
			VAR ActualUnits = 
			    SWITCH (
			        SelectedType,
			        "2W", CALCULATE (
			                  COUNTROWS ( gold_dpmc_vs_2w3w4w_factsales ),
			                  gold_dpmc_vs_2w3w4w_dimproduct[STR_PRODLINE_DESC] = "2 WHEELERS",
			                  gold_dpmc_vs_2w3w4w_factsales[InvoiceDate] >= MonthStart,
			                  gold_dpmc_vs_2w3w4w_factsales[InvoiceDate] <= CutoffDate,
			                  TREATAS ( BranchCodes, gold_dpmc_vs_2w3w4w_dimpremises[PremiseCode] )
			              ),
			        "3W", CALCULATE (
			                  COUNTROWS ( gold_dpmc_vs_2w3w4w_factsales ),
			                  gold_dpmc_vs_2w3w4w_dimproduct[STR_PRODLINE_DESC] = "3 WHEELERS",
			                  gold_dpmc_vs_2w3w4w_factsales[InvoiceDate] >= MonthStart,
			                  gold_dpmc_vs_2w3w4w_factsales[InvoiceDate] <= CutoffDate,
			                  TREATAS ( BranchCodes, gold_dpmc_vs_2w3w4w_dimpremises[PremiseCode] )
			              ),
			        CALCULATE (
			            COUNTROWS ( gold_dpmc_vs_2w3w4w_factsales ),
			            gold_dpmc_vs_2w3w4w_dimproduct[STR_PRODLINE_DESC] IN { "2 WHEELERS", "3 WHEELERS" },
			            gold_dpmc_vs_2w3w4w_factsales[InvoiceDate] >= MonthStart,
			            gold_dpmc_vs_2w3w4w_factsales[InvoiceDate] <= CutoffDate,
			            TREATAS ( BranchCodes, gold_dpmc_vs_2w3w4w_dimpremises[PremiseCode] )
			        )
			    )
			
			VAR RemainingDays = 
			    CALCULATE (
			        [Remaining Working Days],
			        gold_dpmc_dimdate[TheDate] >= MonthStart,
			        gold_dpmc_dimdate[TheDate] <= MonthEndDate
			    )
			
			VAR Gap = TargetUnits - ActualUnits
			
			RETURN
			IF ( RemainingDays = 0, Gap, DIVIDE ( Gap, RemainingDays ) )
			```
		lineageTag: 17022eed-0c87-467d-b840-fabbea6ff05c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

