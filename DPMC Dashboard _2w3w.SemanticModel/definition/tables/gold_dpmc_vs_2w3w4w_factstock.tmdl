	column RegistrationAgeDays =
			
			IF(
			    ISBLANK(gold_dpmc_vs_2w3w4w_factstock[VehicleNo]) && NOT ISBLANK(gold_dpmc_vs_2w3w4w_factstock[DtmDeclareDate]),
			    DATEDIFF(gold_dpmc_vs_2w3w4w_factstock[DtmDeclareDate], TODAY(), DAY),
			    BLANK()
			)
		formatString: 0
		lineageTag: 0c395d23-02f8-4878-ae9a-b71e4978ef48
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Age Bucket' =
			
			IF(
			    ISBLANK(gold_dpmc_vs_2w3w4w_factstock[RegistrationAgeDays]), BLANK(),
			    SWITCH(
			        TRUE(),
			        gold_dpmc_vs_2w3w4w_factstock[RegistrationAgeDays] <= 30, "0-30 days",
			        gold_dpmc_vs_2w3w4w_factstock[RegistrationAgeDays] <= 60, "31-60 days",
			        gold_dpmc_vs_2w3w4w_factstock[RegistrationAgeDays] <= 80, "61-80 days",
			        "81 days above"
			    )
			)
		lineageTag: ba7f8788-816b-4823-b73f-1e081f442a26
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column BucketSortOrder =
			
			SWITCH(
			    TRUE(),
			    gold_dpmc_vs_2w3w4w_factstock[RegistrationAgeDays] <= 30, 1,
			    gold_dpmc_vs_2w3w4w_factstock[RegistrationAgeDays] <= 60, 2,
			    gold_dpmc_vs_2w3w4w_factstock[RegistrationAgeDays] <= 80, 3,
			    NOT ISBLANK(gold_dpmc_vs_2w3w4w_factstock[RegistrationAgeDays]), 4,
			    BLANK()
			)
		formatString: 0
		lineageTag: aaf003cf-60d9-46b5-bd07-d3e6540f32c9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Days Pending Bucket' =
			
			VAR d = gold_dpmc_vs_2w3w4w_factstock[PendingDaysFromMDP]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(d), BLANK(),
			        d <= 30, "0-30 days",
			        d <= 60, "31-60 days",
			        d <= 80, "61-80 days",
			        "81 days above"
			    )
		lineageTag: d811d54e-6553-4e98-a7f0-973145e494f7
		summarizeBy: none
		sortByColumn: 'Days Pending Bucket Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Days Pending Bucket Sort' =
			
			VAR d = gold_dpmc_vs_2w3w4w_factstock[PendingDaysFromMDP]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(d), BLANK(),
			        d <= 30, 1,
			        d <= 60, 2,
			        d <= 80, 3,
			        4
			    )
		formatString: 0
		lineageTag: fee5758b-1c19-4b6d-bcd3-bc06d4700e6d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

