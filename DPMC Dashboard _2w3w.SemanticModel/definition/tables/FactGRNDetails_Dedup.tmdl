	partition FactGRNDetails_Dedup = calculated
		mode: import
		source = ```
				
				VAR RankedTable = 
				    ADDCOLUMNS(
				        gold_dpmc_vs_2w3w4w_factgrndetails,
				        "RN",
				        VAR CurChassis = gold_dpmc_vs_2w3w4w_factgrndetails[ChassisNo]
				        VAR CurGatePass = gold_dpmc_vs_2w3w4w_factgrndetails[GatePassNo]
				        VAR CurLoadDate = gold_dpmc_vs_2w3w4w_factgrndetails[DMT_LOADED_DATE]
				        RETURN
				            COUNTROWS(
				                FILTER(
				                    gold_dpmc_vs_2w3w4w_factgrndetails,
				                    gold_dpmc_vs_2w3w4w_factgrndetails[ChassisNo] = CurChassis &&
				                    gold_dpmc_vs_2w3w4w_factgrndetails[GatePassNo] = CurGatePass &&
				                    gold_dpmc_vs_2w3w4w_factgrndetails[DMT_LOADED_DATE] >= CurLoadDate
				                )
				            )
				    )
				RETURN FILTER ( RankedTable, [RN] = 1 )
				```

	annotation PBI_Id = 9ca08d6bdfb14ca2bc021de8811edecf

